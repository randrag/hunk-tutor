{
  "name": "hunk-tutor",
  "version": "0.1.0",
  "description": "An interactive guided tour of Hunk, taught inside a practice review",
  "keywords": [
    "hunk-extension",
    "hunkdiff",
    "terminal",
    "tui",
    "tutor"
  ],
  "homepage": "https://github.com/mikeclarke/hunk-tutor#readme",
  "bugs": {
    "url": "https://github.com/mikeclarke/hunk-tutor/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeclarke/hunk-tutor.git"
  },
  "files": [
    "src",
    "tutor.patch",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "tutor": "hunk patch ./tutor.patch --extension . --theme hunk-tutor --mode stack",
    "generate:patch": "bun run ./scripts/generate-patch.ts",
    "check:patch": "bun run ./scripts/generate-patch.ts --check",
    "test": "bun run check:patch && bun test ./tests"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "diff": "^8.0.3",
    "react": "^19.2.4"
  },
  "packageManager": "bun@1.3.14",
  "hunk": {
    "extensions": [
      "./src/index.tsx"
    ],
    "apiVersion": 5
  }
}
